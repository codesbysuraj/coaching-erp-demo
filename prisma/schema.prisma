generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id          Int          @id @default(autoincrement())
  firstName   String
  middleName  String?
  lastName    String
  gender      String?
  dob         DateTime?
  mobile      String
  email       String?
  aadharNo    String?
  standard    String?
  subjects    String?
  course      String?
  board       String?
  photoUrl    String?
  totalFees   Float?
  targetExams String?
  createdAt   DateTime     @default(now())
  deletedAt   DateTime?
  academics   Academics?
  address     Address?
  admission   Admission?
  attendance  Attendance[]
  fees        Fees[]
  parents     Parents?
  testScores  TestScore[]
}

model Address {
  id             Int     @id @default(autoincrement())
  studentId      Int     @unique
  flatNo         String?
  building       String?
  street         String?
  landmark       String?
  city           String?
  pincode        String?
  railwayStation String?
  telNo          String?
  student        Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Academics {
  id                  Int     @id @default(autoincrement())
  studentId           Int     @unique
  schoolName          String?
  board               String?
  std                 String?
  collegeName         String?
  aggregateMarks      String?
  aggregatePercentage String?
  mathsMarks          String?
  scienceMarks        String?
  previousInstitute   String?
  examsAppeared       String?
  examsQualified      String?
  ltsseScore          String?
  marks8th            String?
  marks9th            String?
  marks10th           String?
  marks11th           String?
  student             Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Parents {
  id           Int     @id @default(autoincrement())
  studentId    Int     @unique
  fatherName   String?
  motherName   String?
  occupation   String?
  fatherMobile String?
  motherMobile String?
  fatherEmail  String?
  motherEmail  String?
  fatherPan    String?
  motherPan    String?
  fatherAadhar String?
  motherAadhar String?
  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Admission {
  id                Int       @id @default(autoincrement())
  studentId         Int       @unique
  center            String?
  stream            String?
  subjectGroup      String?
  formNumber        String?
  admissionDate     DateTime?
  additionalSubject String?
  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Fees {
  id            Int       @id @default(autoincrement())
  studentId     Int
  grossFees     String?
  concession    String?
  totalPayable  String?
  installmentNo Int?
  amountPaid    Float?
  paymentDate   DateTime?
  paymentMode   String?
  bankName      String?
  transactionId String?
  chequeNo      String?
  receiptNo     String?
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  date      DateTime
  subject   String   @default("General")
  status    String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date, subject])
}

model TestScore {
  id            Int      @id @default(autoincrement())
  studentId     Int
  subject       String
  testName      String
  maxMarks      Float
  obtainedMarks Float
  date          DateTime
  createdAt     DateTime @default(now())
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Admin {
  id                  Int             @id @default(autoincrement())
  name                String
  email               String          @unique
  passwordHash        String
  role                String          @default("ADMIN")
  createdAt           DateTime        @default(now())
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  loginLogs           AdminLoginLog[]
}

model AdminLoginLog {
  id         Int      @id @default(autoincrement())
  adminId    Int
  email      String
  name       String
  ipAddress  String?
  userAgent  String?
  loggedInAt DateTime @default(now())
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
}
